# =============================================================================
# Doom64-RT — keep tooling, docs, authored RT materials; drop rebuildable bulk
# =============================================================================

# --- Python / AI ---
tools/.venv-ai/
tools/**/__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
.env
.python-version

# --- Engine builds & vendored binaries (multi‑GB) ---
sourcecode/
gzdoom-rt-1.0.2/
runtime-mod/
deps/
**/build/
**/RelWithDebInfo/
**/Debug/
**/Release/
**/CMakeFiles/
**/CMakeCache.txt
*.exe
*.dll
*.lib
*.pdb
*.ilk
*.exp
*.obj

# --- Game / mod content not authored here (redistribute separately) ---
DoomCE/
# Other Doom 64 ports kept alongside Retribution for comparison. Somebody
# else's game data, so the whole folder stays out -- unlike Doom64-Retribution/,
# which is listed file by file below because this project DOES author things
# inside it (the fix wads, the pk3s, Retribution-RT-Materials).
Doom64-Beta64/
Doom64-UnseenEvil/
Doom64-Retribution/D64RTR_v15.WAD
Doom64-Retribution/D64RTR\[v1.5\].WAD
Doom64-Retribution/D64MUS.PK3
Doom64-Retribution/DOOMSND.SF2
Doom64-Retribution/libfluidsynth*.dll
Doom64-Retribution/*.SF2
tools/_gallery/*.bmp
tools/_gallery/*.jpg
tools/_gallery/*.jpeg
# Prefer shipping materials under Retribution-RT-Materials/; ignore engine-local copies
sourcecode/**/rt/mat/
sourcecode/**/rt/mat_dev/
# DoomCE Substance→RT convert output (regenerate via tools/convert_ce_pbr_to_rt.py)
Doom64-Retribution/Retribution-RT-Materials-CE/

