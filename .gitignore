# =============================================================================
# Doom64-RT — keep tooling, docs, authored RT materials; drop rebuildable bulk
# =============================================================================

# --- Python / AI ---
tools/.venv-ai/
tools/**/__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
.env
.python-version

# --- Engine builds & vendored binaries (multi‑GB) ---
sourcecode/
gzdoom-rt-1.0.2/
runtime-mod/
deps/
**/build/
**/RelWithDebInfo/
**/Debug/
**/Release/
**/CMakeFiles/
**/CMakeCache.txt
*.exe
*.dll
*.lib
*.pdb
*.ilk
*.exp
*.obj

# --- Game / mod content not authored here (redistribute separately) ---
DoomCE/
# Other Doom 64 ports kept alongside Retribution for comparison. Somebody
# else's game data, so the whole folder stays out -- unlike Doom64-Retribution/,
# which is listed file by file below because this project DOES author things
# inside it (the fix wads, the pk3s, Retribution-RT-Materials).
Doom64-Beta64/
Doom64-UnseenEvil/
Doom64-Retribution/D64RTR_v15.WAD
Doom64-Retribution/D64RTR\[v1.5\].WAD
Doom64-Retribution/D64MUS.PK3
Doom64-Retribution/DOOMSND.SF2
Doom64-Retribution/libfluidsynth*.dll
Doom64-Retribution/*.SF2
# Rest of the ModDB extract -- Retribution's own brightmaps, readmes and dev
# package, none of it ours to redistribute. Got swept in by the initial
# commit before this line existed; removed once found.
Doom64-Retribution/D64RTR_BRIGHTMAPS.PK3
Doom64-Retribution/D64RTR_CHANGELOG.TXT
Doom64-Retribution/D64RTR_INSTRUCTIONS.TXT
Doom64-Retribution/D64RTR_README.TXT
Doom64-Retribution/D64RTRDEV/
tools/_gallery/*.bmp
tools/_gallery/*.jpg
tools/_gallery/*.jpeg
# Prefer shipping materials under Retribution-RT-Materials/; ignore engine-local copies
sourcecode/**/rt/mat/
sourcecode/**/rt/mat_dev/
# DoomCE Substance→RT convert output (regenerate via tools/convert_ce_pbr_to_rt.py)
Doom64-Retribution/Retribution-RT-Materials-CE/

# Optional third-party add-ons the user downloads themselves (currently
# D64ClassicRecolored from ModDB, offered as a checkbox in the launcher). The
# launcher reads this folder and loads what it finds there untouched; none of it
# is ours to commit or redistribute.
Addons/*
!Addons/PUT-YOUR-ADDONS-HERE.txt

# --- Regenerable gallery / emis QA maps & diagnostic packs ---
Doom64-Retribution/d64rtexg0[1-8].wad
Doom64-Retribution/d64remis.wad
Doom64-Retribution/d64remisiso.wad
Doom64-Retribution/d64remptyg.wad
Doom64-Retribution/d64r-emis-iso-*.pk3
Doom64-Retribution/d64r-emptygallery-*.pk3
Doom64-Retribution/d64r-gallery-orbit-sweep.pk3
Doom64-Retribution/d64r-gallery-yaw-sweep.pk3
Doom64-Retribution/d64r-gallery-spawn-*.pk3
Doom64-Retribution/d64r-gallery-wall-ab.pk3
Doom64-Retribution/d64r-texgallery-batches-mapinfo.pk3

# --- Capture bulk under tools/ (keep JSON/manifests/scripts; drop PNGs) ---
# Every lab and gallery writes its screenshots under tools/, and each new one
# used to need its own line here (_gallery, _edgelab, _traillab, ...). Blanket
# rule instead: no PNG under tools/ is source, EXCEPT the authored art below,
# which is packed into pk3s and has no generator to re-make it.
tools/**/*.png
!tools/d64r-lostsoul-rt/**/*.png
!tools/d64r-rt-sky/**/*.png
!tools/_sflatas_authored/**/*.png
!tools/mugshot-art/**/*.png
!tools/_assets/**/*.png
!tools/_titlelogo/**/*.png
!tools/_widescreen_gfx/**/*.png
# (the brightened debug moon preview stays ignored -- re-listed further down)
tools/_gallery/**/Screenshot_*.png
tools/_gallery/**/stdout*.txt
# ephemeral AI corner review dumps (PNGs already ignored; skip whole batch dirs)
tools/_gallery/batch_ai_corner_*/
# large generated UDMF dump (rebuild via build_texture_gallery.py)
tools/_gallery/TEXTMAP.txt
tools/_enemy_gallery/**/*.png
tools/_enemy_gallery/**/Screenshot_*.png
tools/_enemy_gallery/**/stdout*.txt
tools/_decorate_extract.txt
tools/_emis_iso/**/*.png
tools/_emis_iso/**/Screenshot*
tools/_emis_iso/**/stdout*
tools/wash-qa/**/*.spv
tools/wash-qa/**/Screenshot*
tools/wash-qa/**/*.png

# --- Ephemeral map isolation / compare dumps ---
tools/_map_cmp/
tools/_map_isol/
tools/_orm_metal_fix/
tools/_orm_rough_fix/
tools/**/map01_*.wad
tools/map01_*.wad

# --- Local smoke / crash / screenshot dumps ---
smoke-*.txt
smoke-*.err
crash-*.txt
crash-*.err
build-gzdoom-rt.log
cmd.txt
screen/
screenshots/
*.log

# --- OS / editor ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*~

# --- Archives / temp ---
*.zip
*.7z
*.rar
*.tmp
*.bak

# --- 3D-floor strip wads (make_map_3dfloor_rtfix.py --mode strip) ---
# Nothing loads them since 2026-08-23: the 3D floors are played as authored and
# the freeze that motivated the strip is fixed in gzdoom-rt (p_3dfloors.cpp).
# Kept out of the tree entirely; the emergency strip arm regenerates them.
Doom64-Retribution/d64r-*-rtfix.wad

# --- Scratch / temp scripts ---
tools/_tmp_*.py
tools/_switch_qa/

# --- Hugging Face / model caches (if ever dropped in-tree) ---
.cache/
**/huggingface/
**/.huggingface/

# A/B snapshots of built RTGL runtimes (DLL + SPIR-V). Reproducible from
# git history via tools/build-rtgl.cmd; never commit the binaries.
tools/rtgl-variants/

# Brightened debug copy of the moon sky, written by tools/gen_moon_sky.py
# --preview. The real texture is near-black and unreadable on a monitor; this
# one is only for looking at. pack_rt_sky.py deliberately does not ship it --
# it would put a second, wrong sky in the pk3 under a name GZDoom resolves.
tools/d64r-rt-sky/textures/MOONSKY_preview.png

# Backups made by tools/gen_lava_material.py --apply, restored by --revert.
# Local undo state, not source: the overlays it holds are whatever happened to
# be in the tree at the time.
tools/_lava_mat_backup/

# Unattended A/B capture output (tools/ab-lava.cmd + rt_autoshot).
tools/_lavashot/
rt-lava.log

# Smoke-lab captures: regenerated by tools/smoke-lab.cmd on demand.
tools/_smokelab/

# Packaged release build: ~1.9 GB across ~39k files, and it contains
# single files over GitHub's 100 MB hard limit (a bundled PowerShell zip),
# so committing it produces a push that cannot succeed.
ReleaseTest/
# Same artifact from tools/package_release.py, which defaults to --out dist:
# ~4.3k files of build output plus a 131 MB zip (the zip is already covered
# by *.zip). Rebuild with: python tools/package_release.py --out dist --zip
dist/

# Written by the launcher: the IWAD path the user picked. Machine-local state,
# and it carries a personal filesystem path.
doom64-rt-settings.txt
configdone.txt

# Backups taken by tools/apply_material_labels.py and
# tools/bake_material_labels_orm.py before the first write. Local undo state:
# "--revert" reads them, and they are regenerable by reverting and re-applying.
*.pre_material_labels
*.pre_sprite_materials

# DXC (GitHub release build with SPIR-V codegen) -- 130+ MB of binaries needed
# only to generate deps/NRD/_Shaders (which lives under the ignored deps/ and
# is re-generated by tools/build-nrd-deps.cmd on a fresh checkout).
tools/dxc/

# (deps/ is already ignored wholesale by policy -- the NRD/NRI/MathLib/
# ShaderMake trees, their build outputs and the generated _Shaders headers all
# live there and are reproduced by tools/build-nrd-deps.cmd. The one tracked
# NRD-lane source file is tools/nrd/NRDConfig.hlsli, which that script
# installs into deps/NRD/Shaders/.)

# NRDIntegration's step log, written to the game CWD on every NRD instance
# creation (NRD_INTEGRATION_DEBUG_LOGGING is kept on -- the NRD bring-up hung
# invisibly twice and this file is how the step is found next time).
NRD-Doom64RT.log

# Raw preview screenshots (multi-MB PNGs, source material for the README
# gallery). The compressed docs/img/preview/preview-*.jpg files are what's
# tracked and linked from the README; these originals stay local.
docs/img/preview/*.png

# Flashlight sound source (external MP3, not our asset). The generated
# DFL*.wav clips and D64FLK*.wav are committed as game assets.
music/fluorescentflicker.mp3

dist-test/*
dist-patch/*

# Unseen Evil monster pk3. It carries DrPyspy's sprites and sounds, and Unseen
# Evil ships no licence statement, so the ART stays out of this repository --
# only the generator and the authored lumps (tools/pack_ue_monsters.py,
# tools/d64r-ue-monsters/) are committed. Build it locally with:
#     python tools/pack_ue_monsters.py
# Same rule the Doom64-UnseenEvil/ overlays already follow.
Doom64-Retribution/d64r-ue-monsters.pk3

# Arch-Vile flame masks and the review page. Both are DERIVED from DrPyspy's
# Unseen Evil sprites -- the _e files are a recoloured subset of his pixels, and
# the gallery embeds the frames themselves as base64 data URIs. Same rule as
# d64r-ue-monsters.pk3 above: the generators are committed, the art is not.
#   tools\.venv-ai\Scripts\python.exe tools/gen_vile_glow_emissives.py
#   tools\.venv-ai\Scripts\python.exe tools/build_vile_glow_gallery.py
Doom64-Retribution/Retribution-RT-Materials/rt/mat/VILE*_e.png
Doom64-Retribution/Retribution-RT-Materials/rt/mat_dev/VILE*_e.png
tools/vile-glow-gallery.html
tools/sprite-mark-gallery.html
tools/glow-gallery.html
