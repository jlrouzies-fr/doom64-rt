# --- Generated 3D-floor patches (regenerate via make_map_3dfloor_rtfix.py) ---
# The PER-MAP copies are debug artifacts and stay out. The COMBINED wad ships:
# the launcher refuses to start without it, and it is the same class of artifact
# as d64r-seqlight-fix.wad, which has always been tracked.
Doom64-Retribution/d64r-*-rtfix.wad
!Doom64-Retribution/d64r-3dfloor-rtfix.wad

# --- Scratch / temp scripts ---
tools/_tmp_*.py
tools/_switch_qa/

# --- Hugging Face / model caches (if ever dropped in-tree) ---
.cache/
**/huggingface/
**/.huggingface/

# A/B snapshots of built RTGL runtimes (DLL + SPIR-V). Reproducible from
# git history via tools/build-rtgl.cmd; never commit the binaries.
tools/rtgl-variants/

# Brightened debug copy of the moon sky, written by tools/gen_moon_sky.py
# --preview. The real texture is near-black and unreadable on a monitor; this
# one is only for looking at. pack_rt_sky.py deliberately does not ship it --
# it would put a second, wrong sky in the pk3 under a name GZDoom resolves.
tools/d64r-rt-sky/textures/MOONSKY_preview.png

# Backups made by tools/gen_lava_material.py --apply, restored by --revert.
# Local undo state, not source: the overlays it holds are whatever happened to
# be in the tree at the time.
tools/_lava_mat_backup/

# Unattended A/B capture output (tools/ab-lava.cmd + rt_autoshot).
tools/_lavashot/
rt-lava.log

# Smoke-lab captures: regenerated by tools/smoke-lab.cmd on demand.
tools/_smokelab/

# Packaged release build: ~1.9 GB across ~39k files, and it contains
# single files over GitHub's 100 MB hard limit (a bundled PowerShell zip),
# so committing it produces a push that cannot succeed.
ReleaseTest/

# Written by the launcher: the IWAD path the user picked. Machine-local state,
# and it carries a personal filesystem path.
doom64-rt-settings.txt

# Backups taken by tools/apply_material_labels.py and
# tools/bake_material_labels_orm.py before the first write. Local undo state:
# "--revert" reads them, and they are regenerable by reverting and re-applying.
*.pre_material_labels
*.pre_sprite_materials
