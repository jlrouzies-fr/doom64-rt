version "4.12"

// Horror flashlight battery HUD — match Retribution SBARINFO ForceScaled HUD.
// SBARINFO: Resolution 320x240, HEALTH/value centered on x=24 at y=208/217.
// Battery sits in a column LEFT of HEALTH (same baselines), KeepRatio like ForceScaled
// so ultrawide pillarbox alignment matches the stock HUD (not full-bleed stretch).
class D64RtFlashlightHud : EventHandler
{
	// --- battery audio -------------------------------------------------
	// The engine writes rt_flsh_battstate (0=off 1=on 2=dying 3=recharge) and
	// bumps rt_flsh_flicker every time the beam starts a fade-out. We only
	// watch those readouts here: no state of our own to keep in sync.
	private int  prevState;
	private int  prevFlicker;
	private bool audioPrimed;

	override void WorldTick()
	{
		CVar stateC = CVar.FindCVar("rt_flsh_battstate");
		CVar flickC = CVar.FindCVar("rt_flsh_flicker");
		if (stateC == null || flickC == null)
			return;

		int state = stateC.GetInt();
		int flick = flickC.GetInt();

		// First tic of a level: adopt the readouts, don't fire on them.
		if (!audioPrimed)
		{
			prevState = state;
			prevFlicker = flick;
			audioPrimed = true;
			return;
		}

		double vol = SoundVolume();
		if (vol > 0.0)
		{
			if (state == 3 && prevState != 3)
			{
				// Burnout: the beam gutters out. Swallow the flicker bump that
				// came with it so we don't stack a blip on top of the death.
				S_StartSound("d64rt/flashlight/out", CHAN_AUTO, CHANF_UI, vol);
			}
			else if (state == 1 && prevState == 3)
			{
				// Recharged: filament finding its pitch again.
				S_StartSound("d64rt/flashlight/on", CHAN_AUTO, CHANF_UI, vol * 0.6);
			}
			else if (flick != prevFlicker && (state == 1 || state == 2))
			{
				// Mid-cycle blink (1) or a dying gutter (2).
				S_StartSound("d64rt/flashlight/flicker", CHAN_AUTO, CHANF_UI,
					vol * (state == 2 ? 0.75 : 0.5));
			}
		}

		prevState = state;
		prevFlicker = flick;
	}

	override void WorldLoaded(WorldEvent e)
	{
		audioPrimed = false;
	}

	private double SoundVolume()
	{
		CVar onC = CVar.GetCVar("d64rt_flsh_sound", players[consoleplayer]);
		if (onC != null && !onC.GetBool())
			return 0.0;
		CVar volC = CVar.GetCVar("d64rt_flsh_sound_vol", players[consoleplayer]);
		double v = volC != null ? volC.GetFloat() : 1.0;
		return Clamp(v, 0.0, 1.0);
	}

	override void RenderOverlay(RenderEvent e)
	{
		// Gameplay only. DrawTopStuff -- and so RenderOverlay -- is dispatched
		// for GS_TITLELEVEL as well as GS_LEVEL (d_main.cpp:1008), and the title
		// screen IS a level here: Retribution's TITLEMAP is the zooming "DOOM"
		// map with the monster fight. Without this the battery meter sits on the
		// main menu from the first frame. GS_INTERMISSION and GS_FINALE never
		// reach this hook at all, but the check covers them for free.
		if (gamestate != GS_LEVEL)
			return;

		// ...and the story screens are LEVELS too, so the gamestate check alone
		// does not cover them. MAP00 is "The Story so Far" (New Game) and
		// INTER01..INTER13 are the between-episode text maps -- all real maps
		// with a player in them, all GS_LEVEL. Match by name; there is no flag
		// that separates them from a playable map.
		string mn = level.MapName;
		mn = mn.MakeUpper();
		if (mn == "MAP00" || mn.Left(5) == "INTER")
			return;

		CVar flsh = CVar.FindCVar("rt_flsh");
		CVar batt = CVar.FindCVar("rt_flsh_battery");
		if (batt != null && !batt.GetBool())
			return;
		bool lightOn = flsh != null && flsh.GetBool();

		CVar chargeC = CVar.FindCVar("rt_flsh_charge");
		CVar stateC  = CVar.FindCVar("rt_flsh_battstate");
		double charge = 0.0;
		if (chargeC != null)
		{
			charge = chargeC.GetFloat();
			if (charge < 0.0) charge = 0.0;
			if (charge > 1.0) charge = 1.0;
		}
		int state = stateC != null ? stateC.GetInt() : 0;
		// Charge persists across a toggle now, so the meter still means something
		// with the beam off — keep it up (dimmed) until the cell is topped up.
		// Always on screen: the meter used to hide itself whenever the beam was
		// off and the cell was full, so the HUD gained and lost an element as
		// you played. It stays put now and just dims through the state levels.

		int segs = 5;
		int lit = int(Floor(charge * segs + 0.000001));
		if (charge > 0.02 && lit < 1) lit = 1;
		if (charge >= 0.995) lit = segs;

		// Follow the HUD's own opacity (d64_hud_alpha, 0..100) instead of the
		// 0.55 these levels were authored against. That constant matched
		// Retribution's baked-in SBARINFO alpha; now that the HUD alpha is a
		// user setting, hardcoding it left the battery ~45% fainter than
		// everything around it. The per-state factors below are the ORIGINAL
		// levels expressed relative to that 0.55 baseline, so the dimming of
		// the off/flashing/low states is preserved exactly.
		double hudA = 1.0;
		CVar hudAC = CVar.FindCVar("d64_hud_alpha");
		if (hudAC != null)
			hudA = Clamp(hudAC.GetInt(), 0, 100) / 100.0;
		double opacity = hudA;
		if (state == 0)
			opacity = hudA * 0.51; // switched off, trickle-charging
		else if (state == 2)
			opacity = ((Level.Time / 4) % 2 == 0) ? hudA : hudA * 0.40;
		else if (state == 3)
			opacity = hudA * 0.73;

		int VW = 320;
		int VH = 240;

		Font fnt = Font.GetFont("D64HUDFONT");
		if (fnt == null)
			fnt = SmallFont;

		// Same baselines as HEALTH (208) / health value (217)
		// Bottom-relative, exactly like the SBARINFO coordinates now are:
		// -32 is the HEALTH/ARMOR label row, -23 the value row.
		// Measured against HEALTH in a real frame: at -32 the label landed 6px
		// high, and one virtual unit is ~4.9px here, so -31 lands within ~1px.
		// Measured in a real frame against HEALTH: label top matches at -31,
		// and the meter's centre lines up with the centre of the HEALTH value
		// at -16 (it was 30px high at -22; ~4.9px per virtual unit here).
		int vLabelY = -31;
		int vBarY = -17;
		int vBodyW = 36;
		int vBodyH = 7;
		int vTipW = 2;
		int vTipH = 3;
		int vPad = 1;
		int vGap = 1;
		int vRim = 1;

		// HEALTH is center-aligned on x=24 — find its left edge, place BATTERY
		// in a column just to the left (Copy mockup: side-by-side, not stacked).
		int healthW = fnt.StringWidth("HEALTH");
		int battW = fnt.StringWidth("BATTERY");
		int healthLeft = 24 - healthW / 2;
		int gap = 8;
		// Column immediately left of HEALTH (Copy mockup). Negative is OK —
		// KeepRatio maps it into the ultrawide left margin beside the HUD.
		// Anchored INSIDE the 320-wide HUD, not derived from HEALTH. The old
		// derivation put the label at about -58, i.e. entirely off the left
		// of the HUD box, so only part of the bar showed and the word
		// BATTERY was never visible. HEALTH and the mugshot moved right in
		// build_mugshot_pk3.py (HEALTH_X / FACE_X) to clear this column.
		int battLeft = 0;   // resolved after the scale block below

		// ForceScaled / KeepRatio mapping (must match DrawText DTA_KeepRatio)
		int sw = Screen.GetWidth();
		int sh = Screen.GetHeight();
		// Aspect-matched virtual width. The rest of the HUD now uses SBARINFO
		// FullScreenOffsets, where x is measured from the real screen edge. A
		// plain 320-wide KeepRatio box is letterboxed on an ultrawide, so the
		// battery would sit inside that box while HEALTH sat at the true edge.
		// Widening the virtual space to the screen's own aspect makes KeepRatio
		// produce no letterbox at all: ox becomes 0 and x=4 means 4 units from
		// the left of the monitor, the same as the SBARINFO coordinates.
		int VWfs = Max(VW, int(VH * sw / double(sh) + 0.5));   // provisional
		// Match the status bar's scale ANALYTICALLY rather than by asking it.
		// base_sbar.cpp:385-405 computes, for a 320x240 bar on a wide screen:
		//     SBarScale = h * hud_scalefactor * (1 / ViewportPixelAspect) / 240
		// Two traps here, both hit already:
		//   * a plain sh/240 omits the pixel-aspect divisor, which drew the
		//     battery slightly LARGER than HEALTH;
		//   * StatusBar.GetHUDScale() read from RenderOverlay returns SBarScale
		//     as left by whatever draw ran last, not the SBARINFO's own pass,
		//     which came out about half size.
		// HUD_ASPECT is that divisor. 1.2 is GZDoom's classic pixel aspect; if
		// the battery still does not match HEALTH it is the ONE number to move.
		double HUD_ASPECT = 1.098;
		double hudScaleFactor = 1.0;
		CVar hsfC = CVar.FindCVar("hud_scalefactor");
		if (hsfC != null && hsfC.GetFloat() > 0.05)
			hudScaleFactor = hsfC.GetFloat();
		double scale  = (sh / double(VH)) * hudScaleFactor / HUD_ASPECT;
		double scaleX = scale;
		// Virtual space sized so DTA_Virtual* reproduces exactly that scale,
		// with y measured up from the bottom edge of the real screen.
		VWfs = Max(1, int(sw / scaleX));
		// Virtual space sized to reproduce exactly that scale, so DTA_Virtual*
		// units are the same units the SBARINFO coordinates use.
		int VHfs = Max(1, int(sh / scale));
		double ox = 0;
		double oy = sh;

		// Where the battery column sits depends on the HUD style.
		//   Modern (1): the SBARINFO layout is screen-anchored, so hug the left
		//               edge. 12 rather than 4 - at 4 the first glyph of
		//               "BATTERY" was being clipped by the screen edge.
		//   Classic (0): the stock layout is centre-relative, so sit a gap to
		//               the left of HEALTH's own left edge, which in that style
		//               is centre-160+24.
		int hudStyle = 1;
		CVar styleC = CVar.FindCVar("d64_hud_style");
		if (styleC != null)
			hudStyle = styleC.GetInt();
		if (hudStyle >= 1)
		{
			battLeft = 6;
		}
		else
		{
			int centreX = VWfs / 2;
			battLeft = centreX - 160 + 24 - healthW / 2 - 8 - battW;
			if (battLeft < 2)
				battLeft = 2;
		}

		int bodyW = Max(1, int(vBodyW * scaleX + 0.5));
		int bodyH = Max(1, int(vBodyH * scale + 0.5));
		int tipW = Max(1, int(vTipW * scaleX + 0.5));
		int tipH = Max(1, int(vTipH * scale + 0.5));
		int pad = Max(1, int(vPad * scaleX + 0.5));
		int gapPx = Max(1, int(vGap * scaleX + 0.5));
		int rim = Max(1, int(vRim * scaleX + 0.5));
		int shad = Max(1, int(scale + 0.5));

		// Center the cell bar under the BATTERY label
		int labelMidX = battLeft + battW / 2;
		int bx = int(ox + labelMidX * scaleX) - bodyW / 2;
		int by = int(oy + vBarY * scale);

		Color shell   = Color(0x2A, 0x22, 0x22);
		Color shellHi = Color(0x7A, 0x74, 0x74);
		Color shellLo = Color(0x14, 0x10, 0x10);
		Color well    = Color(0x10, 0x0C, 0x0C);
		Color fillTop = Color(0x9A, 0x22, 0x22);
		Color fillBot = Color(0x58, 0x10, 0x10);
		Color emptyTop = Color(0x28, 0x14, 0x14);
		Color emptyBot = Color(0x14, 0x0A, 0x0A);
		Color shadow  = Color(0x00, 0x00, 0x00);
		if (state == 2)
		{
			fillTop = Color(0x7A, 0x18, 0x18);
			fillBot = Color(0x40, 0x0A, 0x0A);
		}
		else if (state == 3)
		{
			fillTop = Color(0x5A, 0x16, 0x16);
			fillBot = Color(0x30, 0x0C, 0x0C);
		}

		// --- Label: same font/alpha/baseline as HEALTH, no background box ---
		Screen.DrawText(fnt, Font.CR_BLACK, battLeft + 1, VHfs + vLabelY + 1, "BATTERY",
			DTA_VirtualWidth, VWfs, DTA_VirtualHeight, VHfs,
			DTA_KeepRatio, true,
			DTA_Alpha, hudA * 0.45);
		Screen.DrawText(fnt, Font.CR_UNTRANSLATED, battLeft, VHfs + vLabelY, "BATTERY",
			DTA_VirtualWidth, VWfs, DTA_VirtualHeight, VHfs,
			DTA_KeepRatio, true,
			DTA_Alpha, hudA);

		// --- Cased meter (Dim uses real pixels via KeepRatio ox/oy/scale) ---
		Screen.Dim(shadow, opacity * 0.30, bx + shad, by + shad, bodyW + tipW + rim, bodyH + rim);
		Screen.Dim(shell, opacity * 0.80, bx, by, bodyW, bodyH);
		Screen.Dim(shellHi, opacity * 0.85, bx, by, bodyW, rim);
		Screen.Dim(shellHi, opacity * 0.70, bx, by, rim, bodyH);
		Screen.Dim(shellLo, opacity * 0.85, bx, by + bodyH - rim, bodyW, rim);
		Screen.Dim(shellLo, opacity * 0.70, bx + bodyW - rim, by, rim, bodyH);

		int wellX = bx + rim;
		int wellY = by + rim;
		int wellW = bodyW - rim * 2;
		int wellH = bodyH - rim * 2;
		Screen.Dim(well, opacity * 0.65, wellX, wellY, wellW, wellH);

		int tipX = bx + bodyW;
		int tipY = by + (bodyH - tipH) / 2;
		Screen.Dim(shellHi, opacity * 0.75, tipX, tipY, tipW, tipH);
		Screen.Dim(shellLo, opacity * 0.65, tipX, tipY + tipH / 2, tipW, Max(1, tipH - tipH / 2));

		int innerX = wellX + pad;
		int innerY = wellY + Max(1, pad / 2);
		int innerW = wellW - pad * 2;
		int innerH = Max(1, wellH - pad);
		int cellW = (innerW - gapPx * (segs - 1)) / segs;
		if (cellW < 1) cellW = 1;
		int half = Max(1, innerH / 2);
		int botH = Max(1, innerH - half);
		double cellA = opacity * 0.80;

		for (int i = 0; i < segs; i++)
		{
			int cellX = innerX + i * (cellW + gapPx);
			bool on = i < lit;
			Color topC = on ? fillTop : emptyTop;
			Color botC = on ? fillBot : emptyBot;
			double a = on ? cellA : cellA * 0.35;
			Screen.Dim(topC, a, cellX, innerY, cellW, half);
			Screen.Dim(botC, a, cellX, innerY + half, cellW, botH);
		}
	}
}
