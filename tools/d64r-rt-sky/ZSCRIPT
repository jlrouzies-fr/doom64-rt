version "4.12"

class D64RtSkyFix : EventHandler
{
	override void WorldLoaded(WorldEvent e)
	{
		// Retribution night/star sky flat for the raster sky path.
		//
		// MOONSKY is the WAD's own SPACE starfield tiled to 1024 wide with a
		// moon painted into it (tools/gen_moon_sky.py). The width matters:
		// hw_skydome picks xscale = texw < 1024 ? floor(1024/texw) : 1, so the
		// 256-wide SPACE wraps FOUR times around the horizon. At 1024 it wraps
		// once, which is the difference between one moon and four. The starfield
		// itself is unchanged -- MOONSKY is literally four copies of SPACE.
		//
		// The moon is the visible half of a pair. It does not light anything on
		// its own: RT's sky is a rasterised cubemap sampled on ray miss and is
		// not importance-sampled, so a small bright disc in it is far too noisy
		// to carry a room at 1 spp. The shafts come from the analytic
		// directional light, rt_sun_* in tools/launch-retribution-rt.cmd, aimed
		// down the same bearing the disc is painted at. Change one, change both.
		//
		// Fall back to plain SPACE, then SPACEAA, then ISUCK. Never RSKY1 -- that
		// bright Doom II fallback washed indoor sky seams like daylight.
		// Sector skybox rooms (SPACE* mural boxes) are Ignored under RT
		// (white/black bug); rt_sky_always fills outdoor F_SKY1 with this flat.
		// The moon is GEOMETRY now (rt_moon_geo, RT_DrawMoonQuad in
		// hw_skyportal.cpp), drawn along the rt_sun direction and over the dome's
		// cap, so it has no altitude ceiling and MOONSKY carries no moon at all --
		// this is just the starfield. The old code here hid a PAINTED moon when it
		// was asked to go above the dome's 60 degrees, where it would have been
		// sliced by the cap; none of that applies any more.
		TextureID sky = TexMan.CheckForTexture("MOONSKY", TexMan.Type_Any);
		if (!sky.IsValid())
			sky = TexMan.CheckForTexture("SPACE", TexMan.Type_Any);
		if (!sky.IsValid())
			sky = TexMan.CheckForTexture("SPACEAA", TexMan.Type_Any);
		if (!sky.IsValid())
			sky = TexMan.CheckForTexture("ISUCK", TexMan.Type_Any);

		if (sky.IsValid())
		{
			level.ChangeSky(sky, sky);
			Console.Printf("D64RtSkyFix: sky -> %s", TexMan.GetName(sky));
		}
	}
}
